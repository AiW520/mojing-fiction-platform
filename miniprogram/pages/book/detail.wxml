<view class="page-shell safe-top detail-page">
  <view class="topbar"><button class="icon-btn" bindtap="back" aria-label="返回"><image src="/assets/icons/library/back-ink.png"/></button><view class="top-title">作品详情</view><button class="icon-btn share-button" open-type="share" disabled="{{!shareReady}}" aria-label="分享作品"><image src="/assets/icons/library/share-ink.png"/></button></view>
  <view wx:if="{{loading}}" class="detail-loading">正在打开作品…</view>
  <view wx:elif="{{error}}" class="detail-loading"><view class="error-message">{{error}}</view><button class="retry-button" bindtap="loadBook">重新加载</button></view>
  <block wx:else>
    <view class="detail-hero"><button class="detail-cover cover-art {{book.cover}}" bindtap="previewCover" aria-label="查看封面"><image wx:if="{{book.coverImage}}" src="{{book.coverImage}}" mode="aspectFill" binderror="onCoverError"/><view wx:else class="cover-fallback"><text class="cover-fallback-mark">墨境文库</text><text>{{book.title}}</text><text class="cover-fallback-author">{{book.author}}</text></view></button><view class="detail-copy"><view class="tag">{{book.format === 'longform' ? book.serializationStatus === 'complete' ? '长篇完结' : '长篇连载' : book.type}}</view><view class="title-lg">{{book.title}}</view><view class="author">{{book.author}} <text>· 编辑精选</text></view><view class="stats"><view><text class="stat-num">{{book.chapterCount}}章</text><text class="caption">目录</text></view><view><text class="stat-num">{{commentSummary.rating || '—'}}</text><text class="caption">评分 / 5</text></view><view><text class="stat-num">{{book.wordLabel}}</text><text class="caption">篇幅</text></view></view></view></view>
    <view wx:if="{{book.format === 'longform'}}" class="serial-panel"><view class="serial-top"><view><text class="status-dot"></text><text>{{book.serializationStatus === 'complete' ? '已完结' : '连载中'}}</text></view><text>已更新 {{book.chapterCount}} / {{book.plannedChapters}} 章</text></view><view class="serial-track"><view style="width: {{book.serializationProgress}}%"></view></view><view class="serial-bottom"><text>当前 {{book.words}} 字</text><text>目标 {{book.targetWords}} 字 · {{book.serializationProgress}}%</text></view></view>
    <view class="detail-actions"><button class="primary-btn" bindtap="read">{{book.progress ? '继续阅读' : '开始阅读'}}</button><button class="secondary-btn" bindtap="toggleShelf" disabled="{{shelfBusy}}">{{inShelf ? '已在书架' : '加入书架'}}</button></view>
    <view class="section synopsis"><view class="section-title">作品简介</view><view class="body">{{book.summary}}</view><view wx:if="{{book.tagline}}" class="book-tagline">“{{book.tagline}}”</view></view>
    <view wx:if="{{storyImages.length}}" class="section"><view class="section-head"><view class="section-title">卷册图景</view><view class="caption">{{storyImages.length}} 幅</view></view><scroll-view scroll-x class="story-gallery"><view class="story-gallery-inner"><block wx:for="{{storyImages}}" wx:key="id"><view class="story-image"><image src="{{item.url}}" mode="aspectFill" binderror="onSceneError" data-id="{{item.id}}"/><view>{{item.title}}</view></view></block></view></scroll-view></view>
    <view wx:if="{{book.characterCount}}" class="section"><view class="section-head"><view class="section-title">人物图鉴</view><button class="section-more" bindtap="openCharacters">查看全部 {{book.characterCount}} 位 ›</button></view><button class="character-preview card" bindtap="openCharacters"><block wx:for="{{book.characters}}" wx:key="id"><view class="portrait portrait-{{index === 0 ? 'a' : index === 1 ? 'b' : 'c'}}"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" binderror="onPortraitError" data-id="{{item.id}}"/><text wx:else>{{item.initial}}</text></view></block><view class="character-preview-copy"><view><block wx:for="{{book.characters}}" wx:key="id">{{index ? '、' : ''}}{{item.name}}</block></view><view class="caption">人物设定随阅读进度解锁</view></view><view class="character-preview-arrow">›</view></button></view>
    <view class="section discussion-section"><view class="section-head"><view><view class="section-title">读者讨论</view><view wx:if="{{commentSummary.rating}}" class="discussion-score"><text class="score-number">{{commentSummary.rating}}</text><text> / 5 · {{commentSummary.ratings}} 人评分</text></view></view><text class="section-more">{{commentSummary.reviews + commentSummary.discussions}} 条</text></view><view class="comment-toolbar"><view class="comment-tabs"><button class="comment-tab {{commentTab === 'review' ? 'active' : ''}}" data-tab="review" bindtap="switchCommentTab">书评 {{commentSummary.reviews}}</button><button class="comment-tab {{commentTab === 'discussion' ? 'active' : ''}}" data-tab="discussion" bindtap="switchCommentTab">讨论 {{commentSummary.discussions}}</button></view><view class="comment-sort"><button class="sort-item {{commentSort === 'latest' ? 'active' : ''}}" data-sort="latest" bindtap="switchSort">最新</button><button class="sort-item {{commentSort === 'popular' ? 'active' : ''}}" data-sort="popular" bindtap="switchSort">最热</button></view></view><button class="comment-entry card" bindtap="startComment"><view class="entry-avatar">我</view><text>{{commentTab === 'review' ? '写一条书评，分享你的阅读感受' : '发起一个讨论，和读者聊聊'}}</text><text class="entry-arrow">›</text></button><view wx:if="{{commentsLoading && !comments.length}}" class="comment-state">正在加载讨论…</view><view wx:elif="{{commentsError}}" class="comment-state"><text>{{commentsError}}</text><button bindtap="retryComments">重新加载</button></view><view wx:elif="{{!comments.length}}" class="comment-state">还没有{{commentTab === 'review' ? '书评' : '讨论'}}，成为第一个发言的人。</view><view wx:else class="comment-list"><view wx:for="{{comments}}" wx:key="id" class="comment-item"><view class="comment-avatar">{{item.initial}}</view><view class="comment-main"><view class="comment-meta"><text>{{item.author}}{{item.status === 'pending' ? ' · 审核中' : ''}}</text><text>{{item.dateLabel}}</text></view><view wx:if="{{item.rating}}" class="comment-stars">{{item.rating}} / 5</view><view wx:if="{{item.spoiler && !item.revealed}}" class="spoiler-cover" data-id="{{item.id}}" bindtap="revealSpoiler">含剧透内容 · 点击查看</view><view wx:else class="comment-content">{{item.content}}</view><view class="comment-actions"><button class="comment-action {{item.liked ? 'liked' : ''}}" data-id="{{item.id}}" bindtap="toggleLike" disabled="{{commentBusy || item.status !== 'published'}}" aria-label="点赞"><image src="/assets/icons/library/like-{{item.liked ? 'active' : 'ink'}}.png"/><text>{{item.likes || 0}}</text></button><button class="comment-action" data-id="{{item.id}}" bindtap="openReplies" disabled="{{item.status !== 'published'}}" aria-label="查看回复"><image src="/assets/icons/library/message-ink.png"/><text>{{item.replies || '回复'}}</text></button><button class="comment-action" data-id="{{item.id}}" bindtap="commentMenu" aria-label="评论操作"><image src="/assets/icons/library/more-ink.png"/></button></view></view></view><button wx:if="{{comments.length < commentsTotal}}" class="more-comments" bindtap="moreComments">{{commentsLoading ? '加载中…' : '加载更多'}}</button></view></view>
    <view wx:if="{{repliesOpen}}" class="reply-sheet" catchtap="stopTap"><scroll-view scroll-y class="reply-panel" catchtap="stopTap"><view class="reply-head"><view><view class="section-title">{{replyTarget.author}} 的讨论</view><view class="caption">{{replyTarget.content}}</view></view><button class="close-reply" bindtap="closeReplies" aria-label="关闭回复"><image src="/assets/icons/library/close-ink.png"/></button></view><view wx:if="{{repliesLoading}}" class="comment-state">正在加载回复…</view><view wx:elif="{{repliesError}}" class="comment-state">{{repliesError}}<button bindtap="retryReplies">重新加载</button></view><view wx:else class="reply-list"><view wx:for="{{replies}}" wx:key="id" class="comment-item"><view class="comment-avatar">{{item.initial}}</view><view class="comment-main"><view class="comment-meta"><text>{{item.author}}</text><text>{{item.dateLabel}}</text></view><view wx:if="{{item.spoiler && !item.revealed}}" class="spoiler-cover" data-id="{{item.id}}" bindtap="revealSpoiler">含剧透内容 · 点击查看</view><view wx:else class="comment-content">{{item.content}}</view><view class="comment-actions"><button class="comment-action {{item.liked ? 'liked' : ''}}" data-id="{{item.id}}" bindtap="toggleLike" disabled="{{commentBusy || item.status !== 'published'}}" aria-label="点赞"><image src="/assets/icons/library/like-{{item.liked ? 'active' : 'ink'}}.png"/><text>{{item.likes || 0}}</text></button><button class="comment-action" data-id="{{item.id}}" bindtap="commentMenu" aria-label="回复操作"><image src="/assets/icons/library/more-ink.png"/></button></view></view></view><view wx:if="{{!replies.length}}" class="comment-state">还没有回复</view><button wx:if="{{replies.length < repliesTotal}}" class="more-comments" bindtap="moreReplies">加载更多回复</button></view><button class="primary-btn reply-button" bindtap="openComposer">回复主题</button></scroll-view></view>
    <view wx:if="{{composerOpen}}" class="composer-sheet" catchtap="stopTap"><scroll-view scroll-y class="composer-panel" catchtap="stopTap"><view class="reply-head"><view><view class="section-title">{{composerTitle}}</view><view class="caption">友善交流，内容会经过审核</view></view><button class="close-reply" bindtap="closeComposer" aria-label="关闭编辑"><image src="/assets/icons/library/close-ink.png"/></button></view><view wx:if="{{commentTab === 'review' && !replyTarget}}" class="rating-picker"><text>评分</text><block wx:for="{{stars}}" wx:key="*this"><button class="rating-star {{item <= draft.rating ? 'selected' : ''}}" data-rating="{{item}}" bindtap="setCommentRating" aria-label="{{item}}星"><image src="/assets/icons/library/star-active.png"/></button></block></view><textarea value="{{draft.content}}" maxlength="1000" adjust-position="true" placeholder="{{replyTarget ? '回复这条讨论…' : commentTab === 'review' ? '说说你最喜欢的地方…' : '和读者聊聊这本书…'}}" bindinput="onCommentInput"></textarea><view class="composer-options"><button class="spoiler-toggle {{draft.spoiler ? 'active' : ''}}" bindtap="toggleSpoiler" aria-role="checkbox" aria-checked="{{draft.spoiler}}">{{draft.spoiler ? '已标记剧透' : '标记剧透'}}</button><text>最多 1000 字</text></view><view wx:if="{{composerError}}" class="composer-error">{{composerError}}</view><button class="primary-btn comment-submit" bindtap="submitComment" disabled="{{posting}}">{{posting ? '提交中' : '发布'}}</button></scroll-view></view>
    <view class="section"><view class="section-head"><view class="section-title">阅读提示</view><view class="caption"><text class="status-dot"></text>{{book.format === 'longform' ? book.serializationStatus === 'complete' ? '长篇完结' : '持续连载' : '完整短篇'}}</view></view><view class="hint-row card"><view><text class="hint-icon">◷</text><text>{{book.format === 'longform' ? '逐章阅读' : '约 ' + book.readMinutes + ' 分钟'}}</text></view><view><text class="hint-icon">☰</text><text>{{book.format === 'longform' ? '已更新 ' : '共 '}}{{book.chapterCount}} 章</text></view><view><text class="hint-icon">◎</text><text>{{book.characterCount}} 位人物</text></view></view></view>
  </block>
</view>
