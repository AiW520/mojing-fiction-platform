<view class="creator-page workbench-page" style="padding-top: {{topInset}}px">
  <view class="creator-top"><button wx:if="{{workId}}" class="creator-icon" bindtap="back" aria-label="返回书房"><image src="/assets/icons/library/back-ink.png" /></button><view class="creator-top-title">{{workId ? '作品工作台' : 'AI 创作'}}</view><button class="creator-icon" bindtap="reload" aria-label="刷新作品" disabled="{{busy}}"><image src="/assets/icons/library/refresh-ink.png" /></button></view>
  <view class="creator-container">
    <view wx:if="{{!workId}}" class="creator-heading"><view><view class="creator-title">{{medium === 'comics' ? '我的漫画' : '我的书房'}}</view><view class="creator-subtitle">{{medium === 'comics' ? comics.length + ' 话草稿与连载' : allWorks.length + ' 部作品'}}</view></view><button wx:if="{{medium === 'novels'}}" class="creator-icon" bindtap="createWork" aria-label="新建作品" hover-class="creator-pressed"><image src="/assets/icons/library/plus-ink.png" /></button><button wx:else class="creator-icon" bindtap="openComicStudio" aria-label="漫画工作室" disabled="{{!comicCanManage}}"><image src="/assets/icons/library/plus-ink.png" /></button></view>
    <view wx:if="{{!workId}}" class="creator-segment studio-media-tabs"><button class="{{medium === 'novels' ? 'active' : ''}}" data-medium="novels" bindtap="chooseMedium">小说</button><button class="{{medium === 'comics' ? 'active' : ''}}" data-medium="comics" bindtap="chooseMedium">漫画</button></view>
    <view wx:if="{{error}}" class="creator-feedback" role="alert">{{error}}</view>
    <view wx:if="{{loading}}" class="creator-state">正在整理书房</view>
    <block wx:elif="{{!workId}}">
      <view class="creator-segment"><button class="{{filter === 'writing' ? 'active' : ''}}" bindtap="chooseFilter" data-filter="writing">创作中</button><button class="{{filter === 'published' ? 'active' : ''}}" bindtap="chooseFilter" data-filter="published">已发布</button></view>
      <block wx:if="{{medium === 'comics'}}">
        <view wx:for="{{comicProjects}}" wx:key="id" class="studio-comic-project"><view class="creator-section-head"><view class="creator-section-title">{{item.title}}</view><text class="creator-muted">{{item.episodes.length}} 话</text></view><button wx:for="{{item.episodes}}" wx:for-item="episode" wx:key="id" class="studio-comic-row" data-id="{{episode.id}}" bindtap="openComicStudio"><view class="studio-comic-number">{{episode.episodeNumber}}</view><view class="studio-comic-copy"><view class="studio-comic-title">{{episode.title}}</view><text class="creator-muted">{{episode.panelCount}} 格 · {{episode.runningJobs ? episode.runningJobs + ' 个任务进行中' : episode.missingImages ? episode.missingImages + ' 格待配图' : episode.pendingReview ? episode.pendingReview + ' 格待审核' : '草稿 v' + episode.version}}</text><text wx:if="{{episode.failedJobs}}" class="studio-comic-warning">{{episode.failedJobs}} 个失败任务</text><text wx:if="{{episode.published && episode.stage !== 'published'}}" class="creator-muted">线上版本 v{{episode.publishedVersion}}</text></view><text class="studio-comic-stage stage-{{episode.stage}}">{{episode.stageLabel}}</text></button></view>
        <view wx:if="{{!comicProjects.length}}" class="creator-state">{{filter === 'published' ? '暂无已发布漫画' : '暂无制作中的漫画'}}</view>
        <button class="studio-import" bindtap="openComicStudio" disabled="{{!comicCanManage}}"><image src="/assets/icons/library/books-ink.png" /><text>{{comicCanManage ? '漫画工作室' : '当前账号暂无漫画制作权限'}}</text><image class="studio-comic-arrow" src="/assets/icons/library/arrow-active.png" /></button>
      </block>
      <block wx:else>
      <block wx:for="{{visibleWorks}}" wx:key="id"><button class="studio-book" bindtap="openWork" data-id="{{item.id}}" hover-class="creator-pressed"><view class="studio-cover"><image wx:if="{{item.coverImage}}" src="{{item.coverImage}}" mode="aspectFill" /><text wx:else>{{item.title}}</text></view><view class="studio-book-copy"><view class="studio-book-title">{{item.title}}</view><view class="creator-subtitle">{{item.type}} · {{item.chapterCount}} {{item.format === 'longform' ? '章' : '段'}}</view><view class="creator-muted">{{item.words}} 字 · {{item.status === 'published' ? '已发布' : '草稿'}}</view></view><text class="studio-chevron">›</text></button></block>
      <view wx:if="{{!visibleWorks.length}}" class="creator-state">{{filter === 'writing' ? '书房里还没有草稿' : '暂无已发布作品'}}<button wx:if="{{filter === 'writing'}}" class="creator-primary" bindtap="createWork">新建作品</button></view>
      <button class="studio-import" bindtap="openAdmin" hover-class="creator-pressed"><image src="/assets/icons/library/books-ink.png" /><text>导入 TXT</text><text class="studio-chevron">›</text></button>
      </block>
    </block>
    <block wx:elif="{{work}}">
      <view class="studio-project"><view class="studio-cover large"><image wx:if="{{coverUrl}}" src="{{coverUrl}}" mode="aspectFill" /><text wx:else>{{work.title}}</text></view><view class="studio-book-copy"><view class="creator-muted">{{work.type}} · {{work.status === 'published' ? '已发布' : '草稿'}}</view><view class="studio-project-title">{{work.title}}</view><view class="creator-subtitle">{{work.chapterCount}} {{work.format === 'longform' ? '章' : '段'}} · {{work.words}} 字</view><button class="creator-link" bindtap="openEditor">{{work.status === 'published' || work.format === 'longform' ? '阅读作品' : '继续 AI 创作'}}<image src="/assets/icons/library/arrow-active.png" /></button></view></view>
      <view class="creator-segment"><button class="{{tab === 'overview' ? 'active' : ''}}" data-tab="overview" bindtap="changeTab">正文</button><button class="{{tab === 'settings' ? 'active' : ''}}" data-tab="settings" bindtap="changeTab">设定</button><button class="{{tab === 'assets' ? 'active' : ''}}" data-tab="assets" bindtap="changeTab">配图</button></view>
      <view wx:if="{{work.status === 'published'}}" class="creator-muted">已发布内容已锁定</view>
      <block wx:if="{{tab === 'overview'}}">
        <view class="studio-tools"><button bindtap="openOutline"><image src="/assets/icons/library/books-active.png" /><view><view>大纲与设定</view><text>人物 · 世界观 · 故事节拍</text></view><text>›</text></button><button bindtap="openCharacters"><image src="/assets/icons/library/user-active.png" /><view><view>角色档案</view><text>{{work.characterCount || 0}} 位角色</text></view><text>›</text></button><button bindtap="openAssets"><image src="/assets/icons/library/read-active.png" /><view><view>封面与正文插图</view><text>{{assets.length}} 个素材</text></view><text>›</text></button></view>
        <view class="creator-section-head"><view class="creator-section-title">正文</view><button class="creator-link" bindtap="openReader">阅读预览</button></view>
        <block wx:for="{{blocks}}" wx:key="id"><button class="studio-block" bindtap="openEditor" data-id="{{item.id}}"><text class="studio-block-number">{{index + 1}}</text><view><view>{{item.sceneTitle || '正文段落'}}</view><text>{{item.content || '空白草稿'}}</text></view><text>›</text></button></block>
        <view wx:if="{{!blocks.length}}" class="creator-state">{{work.format === 'longform' ? '长篇章节已收录于阅读目录' : '还没有正文'}}<button class="creator-primary" bindtap="openEditor">{{work.format === 'longform' || work.status === 'published' ? '查看目录' : '开始 AI 写作'}}</button></view>
        <button wx:if="{{work.status !== 'published' && work.format !== 'longform' && blocks.length}}" class="creator-secondary studio-save" bindtap="submitReview" disabled="{{busy}}">提交审稿</button>
      </block>
      <block wx:elif="{{tab === 'settings'}}">
        <label class="creator-field"><text class="creator-field-label">主角与目标</text><textarea class="creator-input" value="{{settings.protagonist}}" data-field="protagonist" bindinput="inputSetting" maxlength="1000" disabled="{{work.status === 'published'}}" placeholder="人物性格、目标、能力与代价" /></label>
        <label class="creator-field"><text class="creator-field-label">世界与规则</text><textarea class="creator-input" value="{{settings.world}}" data-field="world" bindinput="inputSetting" maxlength="2000" disabled="{{work.status === 'published'}}" placeholder="时代、地点、势力与不可打破的规则" /></label>
        <view class="creator-section-head"><view class="creator-section-title">故事大纲</view><button class="creator-link" bindtap="generateOutline" disabled="{{busy || !textReady || work.status === 'published'}}">{{busy ? '生成中' : 'AI 生成'}}</button></view>
        <textarea class="creator-input studio-outline" value="{{settings.outline}}" data-field="outline" bindinput="inputSetting" maxlength="16000" disabled="{{work.status === 'published'}}" placeholder="章节方向、主要冲突、转折与伏笔" />
        <view wx:if="{{generatedOutline}}" class="studio-suggestion"><view class="creator-section-title">大纲建议</view><text selectable>{{generatedOutline}}</text><view wx:if="{{outlineReview}}" class="studio-job"><text>{{outlineReview.stale ? '报告已失效' : outlineReview.status === 'success' ? '监督审查完成' : outlineReview.message || '审查未完成'}}</text><text wx:for="{{outlineReview.issues}}" wx:key="index">{{item.location}} · {{item.reason}} · {{item.suggestion}}</text></view><view class="creator-row"><button class="creator-secondary" bindtap="discardOutline">舍弃</button><button class="creator-primary" bindtap="adoptOutline">采纳</button></view></view>
        <view wx:if="{{!textReady}}" class="creator-feedback">文本模型尚未配置，当前可手动编辑</view>
        <button class="creator-primary studio-save" bindtap="saveSettings" disabled="{{busy || !settingsDirty || work.status === 'published'}}">保存设定</button>
      </block>
      <block wx:else>
        <view class="studio-switch"><view><view>正文插图</view><text>关键场景 · 横幅配图</text></view><switch checked="{{settings.illustrationsEnabled !== false}}" bindchange="toggleIllustrations" color="#16705b" disabled="{{work.status === 'published'}}" /></view>
        <label class="creator-field"><text class="creator-field-label">统一画面风格</text><textarea class="creator-input" value="{{settings.visualStyle}}" data-field="visualStyle" bindinput="inputSetting" maxlength="1000" disabled="{{work.status === 'published'}}" placeholder="电影感构图、真实材质、人物外貌一致，避免塑料皮肤与过度锐化" /></label>
        <view class="creator-row"><button class="creator-secondary" bindtap="saveSettings" disabled="{{busy || !settingsDirty || work.status === 'published'}}">保存风格</button><button class="creator-primary" bindtap="openEditor" disabled="{{work.status === 'published' || work.format === 'longform'}}">选择正文配图</button></view>
        <view class="creator-section-head"><view class="creator-section-title">素材库</view><button class="creator-link" bindtap="reload">刷新</button></view>
        <view wx:if="{{!assets.length}}" class="creator-state">暂无配图</view>
        <block wx:for="{{assets}}" wx:key="id"><view class="studio-asset"><image wx:if="{{item.displayUrl}}" src="{{item.displayUrl}}" mode="widthFix" data-id="{{item.id}}" binderror="imageError" /><view wx:else class="creator-state">图片加载失败，请刷新</view><view class="studio-asset-caption"><text>{{item.title}}</text><text>{{item.approvalStatus === 'approved' ? '已审核' : item.approvalStatus === 'rejected' ? '已拒绝' : '待审核'}}</text></view><view wx:if="{{canReview && work.status !== 'published'}}" class="creator-row"><button class="creator-secondary" data-id="{{item.id}}" data-decision="reject" bindtap="decideAsset" disabled="{{busy}}">拒绝</button><button class="creator-primary" data-id="{{item.id}}" data-decision="approve" bindtap="decideAsset" disabled="{{busy}}">通过审核</button></view></view></block>
        <view wx:if="{{assets.length && !canReview}}" class="creator-muted">公开展示前需由内容审核员审核</view>
        <block wx:for="{{jobs}}" wx:key="id"><view wx:if="{{item.type === 'creator_image'}}" class="studio-job"><text>{{item.status === 'success' ? '配图已生成' : item.status === 'failed' ? '配图失败' : '配图处理中'}}</text><text wx:if="{{item.errorCode}}">{{item.errorCode}}</text></view></block>
      </block>
    </block>
  </view>
  <view wx:if="{{!workId}}" class="creator-nav"><view class="creator-nav-inner"><button bindtap="openHome"><image src="/assets/icons/library/books-ink.png" /><text>书城</text></button><button class="active" aria-current="page"><image src="/assets/icons/library/pen-active.png" /><text>创作</text></button><button bindtap="openShelf"><image src="/assets/icons/library/read-ink.png" /><text>书架</text></button><button bindtap="openMe"><image src="/assets/icons/library/user-ink.png" /><text>我的</text></button></view></view>
</view>
