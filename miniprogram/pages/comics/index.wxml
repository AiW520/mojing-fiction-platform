<view class="comic-page {{episodeId ? 'is-reading' : ''}}">
  <view wx:if="{{episodeId}}" class="comic-progress"><view style="width: {{readingProgress}}%"></view></view>
  <view class="comic-head" style="padding-top: {{topInset}}px"><button bindtap="back" aria-label="返回"><image class="comic-back-icon" src="/assets/icons/library/arrow-active.png" /></button><text class="comic-title">{{episodeId ? title : selectedSeriesId ? title : '漫画书库'}}</text><text wx:if="{{episodeId}}" class="comic-progress-label">{{readingProgress}}%</text><button wx:if="{{episodeId || selectedSeriesId}}" bindtap="library" aria-label="漫画目录"><image src="/assets/icons/library/books-active.png" /></button><button wx:else bindtap="retry" disabled="{{refreshing}}" aria-label="刷新漫画"><image src="/assets/icons/library/refresh-active.png" /></button><button open-type="share" aria-label="分享漫画"><image src="/assets/icons/library/share-ink.png" /></button></view>
  <view wx:if="{{loading}}" class="comic-state">正在载入漫画</view>
  <view wx:elif="{{error}}" class="comic-state comic-error" role="alert"><text>漫画暂时无法连接</text><text>{{error}}</text><button bindtap="retry">重新连接</button><button bindtap="library" wx:if="{{episodeId}}">返回漫画书库</button><button bindtap="home" wx:else>返回书城</button></view>
  <view wx:elif="{{!episodeId && !selectedSeriesId}}" class="comic-library-content">
    <view class="comic-library-intro"><text>{{series.length}} 本漫画</text><button bindtap="home">返回书城</button></view>
    <view wx:if="{{libraryNotice}}" class="comic-library-notice"><text>{{libraryNotice}}</text><button bindtap="retry" disabled="{{refreshing}}">重新连接</button></view>
    <view wx:if="{{series.length}}" class="comic-library"><button wx:for="{{series}}" wx:key="id" data-id="{{item.id}}" bindtap="openSeries" class="comic-tile" disabled="{{navigating}}" aria-label="{{item.title}}"><view class="comic-cover"><image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" lazy-load data-id="{{item.id}}" binderror="coverError" /><view wx:else class="comic-cover-placeholder"><image src="/assets/icons/library/books-ink.png" /><text>{{item.title}}</text></view></view><text class="comic-card-title">{{item.title}}</text><text class="comic-meta">{{item.episodeCount}} 话 · {{item.panelCount}} 格</text><text class="comic-reading-label">进入话目</text></button></view>
    <view wx:else class="comic-state"><text>暂无已发布的漫画</text><button bindtap="home">返回书城</button></view>
  </view>
  <view wx:elif="{{!episodeId && selectedSeriesId}}" class="comic-library-content">
    <view wx:if="{{selectedSeries}}" class="comic-book-heading"><view class="comic-book-cover"><image wx:if="{{selectedSeries.coverUrl}}" src="{{selectedSeries.coverUrl}}" mode="aspectFill" /><image wx:else src="/assets/icons/library/books-ink.png" mode="aspectFit" /></view><view class="comic-book-copy"><text class="comic-book-title">{{selectedSeries.title}}</text><text class="comic-meta">连载 · {{episodes.length}} 话 · {{selectedSeries.panelCount}} 格</text><button class="comic-start" bindtap="continueReading" disabled="{{navigating || !continueId}}"><image src="/assets/icons/library/read-active.png" />{{continueLabel}}</button></view></view>
    <view class="comic-library-intro"><text>全部话目 · {{episodes.length}} 话</text><button bindtap="library">返回漫画书库</button><button bindtap="retry" disabled="{{refreshing}}" aria-label="刷新话目"><image class="directory-refresh" src="/assets/icons/library/refresh-active.png" /></button></view>
    <view wx:if="{{libraryNotice}}" class="comic-library-notice"><text>{{libraryNotice}}</text><button bindtap="retry">重新连接</button></view>
    <view wx:if="{{episodes.length}}" class="comic-episode-list"><button wx:for="{{episodes}}" wx:key="id" data-id="{{item.id}}" bindtap="open" class="comic-episode-row" disabled="{{navigating}}"><view class="episode-cover"><image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" lazy-load data-id="{{item.id}}" binderror="episodeCoverError" /><view wx:else class="comic-cover-placeholder"><image src="/assets/icons/library/books-ink.png" /></view></view><view class="episode-info"><text class="episode-title">{{item.title}}</text><text class="comic-meta">第 {{item.episodeNumber || index + 1}} 话 · {{item.panelCount}} 格</text><text class="comic-reading-label">{{item.readingLabel}}</text></view><image class="episode-arrow" src="/assets/icons/library/arrow-active.png" /></button></view>
  </view>
  <view wx:else class="comic-strip"><view wx:for="{{panels}}" wx:key="id" class="comic-panel"><text wx:if="{{item.narration}}" class="comic-caption">{{item.narration}}</text><view class="comic-media" style="padding-top: {{item.imagePadding}}%"><image wx:if="{{!failedImages[item.id]}}" src="{{item.imageUrl}}" mode="aspectFit" lazy-load data-id="{{item.id}}" binderror="imageError" bindtap="preview" aria-label="放大漫画画面" /><button wx:else class="comic-state" data-id="{{item.id}}" bindtap="reloadImage">图片载入失败，重试</button></view><text wx:if="{{item.dialogue}}" class="comic-dialogue">{{item.dialogue}}</text></view><view class="comic-state">{{nextId ? '本话完' : '已读至最新话'}}</view><view class="comic-chapter-actions"><button bindtap="changeEpisode" data-id="{{previousId}}" disabled="{{!previousId || navigating}}"><image class="previous-arrow" src="/assets/icons/library/arrow-active.png" />上一话</button><button class="comic-next" bindtap="changeEpisode" data-id="{{nextId}}" disabled="{{!nextId || navigating}}">下一话<image src="/assets/icons/library/arrow-active.png" /></button></view><view class="comic-end-actions"><button bindtap="restart"><image src="/assets/icons/library/refresh-active.png" />从头阅读</button><button bindtap="library"><image src="/assets/icons/library/books-active.png" />作品目录</button></view></view>
</view>
