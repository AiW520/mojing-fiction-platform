<view class="page-shell safe-top me-page">
  <view class="topbar"><view><view class="brand-name">我的</view><view class="caption">你的阅读时光</view></view><view class="brand-mark">墨</view></view>
  <view class="profile card"><view class="profile-avatar">{{initial}}</view><view class="profile-copy"><view class="title-md">{{name}}</view><view class="caption">{{roleLabel}} · {{connected ? '已连接' : '暂未连接'}}</view><view class="profile-stats"><view><text>{{shelfCount}}</text><text class="caption">书架收藏</text></view></view></view></view>
  <view class="section menu-section card"><view class="menu-row" bindtap="openShelf"><view><text class="menu-icon">▱</text><text>我的书架</text></view><text class="menu-count">{{shelfCount}} 本　›</text></view><view class="menu-row" bindtap="changeTheme"><view><text class="menu-icon">Aa</text><text>阅读主题</text></view><text class="menu-count">{{themeLabel}}　›</text></view><view class="menu-row" bindtap="openCreate"><view><text class="menu-icon">＋</text><text>开始创作</text></view><text class="menu-count">新建作品　›</text></view><view class="menu-row" bindtap="openAdmin"><view><text class="menu-icon">▣</text><text>管理员后台</text></view><text class="menu-count">需管理员账号　›</text></view></view>
  <view class="main-nav"><button bindtap="openHome"><image src="/assets/icons/library/books-ink.png"/><text>书城</text></button><button bindtap="openCreate"><image src="/assets/icons/library/pen-ink.png"/><text>创作</text></button><button bindtap="openShelf"><image src="/assets/icons/library/read-ink.png"/><text>书架</text></button><button class="active" aria-current="page"><image src="/assets/icons/library/user-active.png"/><text>我的</text></button></view>
</view>
