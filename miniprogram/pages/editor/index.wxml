<view class="creator-page editor-page" style="padding-top: {{topInset}}px">
  <view class="creator-top"><button class="creator-icon" bindtap="back" aria-label="返回工作台" disabled="{{saving}}"><image src="/assets/icons/library/back-ink.png" /></button><view class="creator-top-title">{{title || 'AI 写作'}}<view class="creator-muted">{{words}} 字 · {{saving ? '保存中' : saved ? '已保存' : '未保存'}}</view></view><button class="creator-icon" bindtap="save" aria-label="保存正文" disabled="{{saving || readOnly}}"><image src="/assets/icons/library/pen-active.png" /></button></view>
  <view wx:if="{{loading || error}}" class="creator-state">{{error || '正在载入正文'}}</view>
  <scroll-view wx:else scroll-y class="block-scroll"><view class="editor-paper">
    <view wx:if="{{readOnly}}" class="creator-feedback">已发布内容已锁定</view>
    <view wx:if="{{!textReady}}" class="editor-model-state">文本模型尚未配置 · 可手动编辑</view>
    <block wx:for="{{blocks}}" wx:key="index"><view class="editor-block {{selected === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="selectBlock"><view class="editor-block-head"><text>{{sceneTitles[index] || '正文段落'}} {{index + 1}}</text><text>{{lockedBlocks[index] ? '已锁定' : selected === index ? '当前选段' : ''}}</text></view><textarea class="block-editor" auto-height value="{{item}}" data-index="{{index}}" bindinput="editBlock" disabled="{{saving || readOnly || lockedBlocks[index]}}" maxlength="-1" placeholder="写下故事的第一段，或使用 AI 续写…" /></view><view wx:if="{{blockAssets[index]}}" class="editor-illustration"><image wx:if="{{blockAssets[index].displayUrl}}" src="{{blockAssets[index].displayUrl}}" mode="widthFix" /><view wx:else class="creator-state">配图暂时无法载入</view><view><text>{{blockAssets[index].title}}</text><text>{{blockAssets[index].approvalStatus === 'approved' ? '已审核' : '待审核'}}</text></view></view></block>
    <button class="editor-add" bindtap="addBlock" disabled="{{readOnly || saving}}"><image src="/assets/icons/library/plus-ink.png" />新增段落</button>
    <view wx:if="{{generating || generationError || generatedText}}" class="generated-panel">
      <view class="creator-section-title">{{generating ? (generatedText ? '监督审查中' : 'AI 正在写作') : generatedText ? '建议稿' : '任务未完成'}}</view>
      <view wx:if="{{generationError}}" class="creator-feedback">{{generationError}}</view><button wx:if="{{jobId && !generating}}" class="creator-secondary" bindtap="checkJob">检查原任务</button>
      <text wx:if="{{generatedText}}" selectable class="generated-copy">{{generatedText}}</text>
      <view wx:if="{{generatedReview}}" class="candidate-review"><view class="creator-section-title">{{reviewLabel}}<text wx:if="{{generatedReview.score !== undefined}}"> · {{generatedReview.score}}/10</text></view><text wx:if="{{generatedReview.message}}">{{generatedReview.message}}</text><view wx:for="{{generatedReview.issues}}" wx:key="index" class="candidate-issue"><text>{{item.type}} · {{item.location}}</text><text>{{item.reason}}</text><text>{{item.suggestion}}</text></view><view wx:for="{{generatedReview.attempts}}" wx:key="modelId" class="candidate-attempt">{{item.name || item.model}} · {{item.status}}{{item.errorCode ? ' · ' + item.errorCode : ''}}<text wx:if="{{item.resultUnknown}}">供应商结果未知，可能已计费</text></view></view>
      <view wx:for="{{modelAttempts}}" wx:key="modelId" class="candidate-attempt">{{item.name || item.model}} · {{item.status}}</view>
      <view wx:if="{{generatedText}}" class="creator-row"><button class="creator-secondary" bindtap="discardGenerated" disabled="{{generating}}">舍弃</button><button class="creator-primary" bindtap="applyGenerated" disabled="{{generating}}">采用结果</button></view>
    </view>
  </view></scroll-view>
  <view class="editor-toolbar"><block wx:for="{{tools}}" wx:key="*this"><button data-name="{{item}}" bindtap="tool" disabled="{{generating || imageBusy || readOnly || loading || saving || (index !== 3 && !textReady)}}" hover-class="creator-pressed"><image src="/assets/icons/library/{{index === 3 ? 'read' : index === 1 ? 'refresh' : 'pen'}}-{{index === 3 ? 'active' : 'ink'}}.png" /><text>{{item}}</text></button></block></view>
  <view wx:if="{{illustrationOpen}}" class="illustration-mask" bindtap="closeIllustration"><view class="illustration-sheet" catchtap="stopTap"><view class="illustration-header"><view class="creator-section-title">小说配图</view><button class="creator-icon" bindtap="closeIllustration" aria-label="关闭配图"><image src="/assets/icons/library/close-ink.png" /></button></view><scroll-view scroll-y class="illustration-scroll"><view class="illustration-form">
    <view class="creator-segment"><button class="{{imageKind === 'scene' ? 'active' : ''}}" data-kind="scene" bindtap="chooseImageKind" disabled="{{imageBusy}}">正文插图</button><button class="{{imageKind === 'cover' ? 'active' : ''}}" data-kind="cover" bindtap="chooseImageKind" disabled="{{imageBusy}}">作品封面</button></view>
    <view wx:if="{{imageKind === 'scene'}}" class="illustration-source"><text class="creator-muted">所选正文 · 第 {{imageIndex + 1}} 段</text><text>{{imageSource || '这一段还没有正文'}}</text></view>
    <label class="creator-field"><text class="creator-field-label">画面名称</text><input class="creator-input" value="{{imageTitle}}" data-field="imageTitle" bindinput="imageInput" maxlength="100" disabled="{{imageBusy}}" placeholder="例如：风雪中的营门" /></label>
    <label class="creator-field"><text class="creator-field-label">主体与动作</text><textarea class="creator-input" value="{{imageSubject}}" data-field="imageSubject" bindinput="imageInput" maxlength="600" disabled="{{imageBusy}}" placeholder="谁在做什么，外貌与衣着，人物间的位置关系" /></label>
    <label class="creator-field"><text class="creator-field-label">时间与场景</text><input class="creator-input" value="{{imagePlace}}" data-field="imagePlace" bindinput="imageInput" maxlength="400" disabled="{{imageBusy}}" placeholder="雪夜、营门、木制瞭望楼、冷色火光" /></label>
    <label class="creator-field"><text class="creator-field-label">构图与镜头</text><input class="creator-input" value="{{imageShot}}" data-field="imageShot" bindinput="imageInput" maxlength="500" disabled="{{imageBusy}}" placeholder="中远景、侧面视角、保留场景细节" /></label>
    <view class="illustration-consent"><view><text>确认生图费用</text><text class="creator-muted">Tuzi · gpt-image-2 · 每素材一次</text></view><switch checked="{{imageConfirmed}}" bindchange="confirmImageCost" color="#16705b" disabled="{{imageBusy}}" /></view>
    <view wx:if="{{!imageReady}}" class="creator-feedback">图片模型尚未配置</view><view wx:if="{{!saved}}" class="creator-feedback">正文尚未保存</view><view wx:if="{{imageError}}" class="creator-feedback" role="status">{{imageError}}</view>
    <button class="creator-primary" bindtap="generateIllustration" disabled="{{imageBusy || generating || imageJobId || !imageReady || !imageConfirmed || !saved}}">{{imageBusy ? '生成中' : imageKind === 'cover' ? '生成封面' : '生成场景插图'}}</button><button wx:if="{{imageJobId && !imageBusy}}" class="creator-link" bindtap="checkImageJob">检查原任务状态</button><button class="creator-link" bindtap="openMaterials">查看素材与审核状态</button>
  </view></scroll-view></view></view>
</view>
