<view class="page-shell safe-top search-page"><view class="topbar"><view class="icon-btn" bindtap="back">‹</view><view class="top-title">搜索</view><view></view></view><view class="search-input-wrap"><text>⌕</text><input focus placeholder="搜索作品、作者或关键词" value="{{query}}" bindinput="input" bindconfirm="submit" /><view bindtap="submit">搜索</view></view><view class="search-hints" wx:if="{{!submitted}}"><view class="caption">热门搜索</view><view class="hint-tags"><text data-query="纸月亮" bindtap="chooseHint">纸月亮</text><text data-query="公路" bindtap="chooseHint">公路</text><text data-query="女性成长" bindtap="chooseHint">女性成长</text><text data-query="治愈奇幻" bindtap="chooseHint">治愈奇幻</text></view></view><view class="search-results" wx:else><view class="section-head"><view class="section-title">搜索结果</view><view class="caption">{{loading ? '正在搜索' : total + ' 部作品'}}</view></view><view wx:if="{{loading && !results.length}}" class="search-state">正在查找作品…</view><view wx:elif="{{error}}" class="search-state"><text>{{error}}</text><button bindtap="submit">重新搜索</button></view><view wx:elif="{{!results.length}}" class="search-state">没有找到相关作品</view><block wx:else wx:for="{{results}}" wx:key="id"><view class="result-card card" data-id="{{item.id}}" bindtap="openBook"><view class="result-cover cover-art {{item.cover}}"><image wx:if="{{item.coverImage}}" src="{{item.coverImage}}" mode="aspectFill" binderror="onCoverError" data-id="{{item.id}}"/><text wx:else>{{item.title}}</text></view><view><view class="title-md">{{item.title}}</view><view class="caption">{{item.author}} · {{item.type}}</view><view class="body">{{item.format === 'longform' ? '连载中 · 已更新 ' + item.chapterCount + ' 章' : item.summary}}</view></view><view class="scene-arrow">›</view></view></block><button wx:if="{{results.length < total}}" class="more-results" bindtap="more">{{loading ? '加载中…' : '加载更多'}}</button></view></view>
