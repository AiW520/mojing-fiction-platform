<view class="page-shell safe-top character-detail"><view class="topbar"><view class="icon-btn" bindtap="back">‹</view><view><view class="top-title">人物详情</view><view class="caption">{{character.name}} · {{character.role}}</view></view><view class="icon-btn" wx:if="{{mode === 'creator'}}" bindtap="toggleEdit">{{editing ? '✓' : '✎'}}</view><view wx:else></view></view><view class="detail-profile"><view class="profile-art cover-art {{character.art}}"><image wx:if="{{character.image}}" src="{{character.image}}" mode="aspectFill"/><text wx:else>{{character.name}}</text></view><view class="profile-info"><view class="title-lg">{{character.name}}</view><view class="tag">{{character.role}}</view><view class="caption">{{character.relation}}</view><view class="body">{{character.intro}}</view></view></view><view wx:if="{{!character.unlocked}}" class="locked-notice card"><view class="locked-icon">⌁</view><view><view class="title-md">人物档案尚未完全解锁</view><view class="body">继续阅读相关场景，解锁秘密和变化轨迹。</view></view></view><view wx:elif="{{mode === 'creator'}}" class="detail-sections"><view class="profile-section card"><view class="section-title">人物弧光</view><view class="arc-row"><view class="arc-point done"><text>起点</text><text>{{character.arcStart}}</text></view><view class="arc-line"></view><view class="arc-point current"><text>现在</text><text>{{character.arcCurrent}}</text></view><view class="arc-line"></view><view class="arc-point"><text>终点</text><text>待故事发生</text></view></view></view><view class="profile-section card"><view class="section-title">创作设定</view><view class="setting-line"><text>核心欲望</text><text class="gold">{{character.desire}}</text></view><view class="setting-line"><text>最大恐惧</text><text class="gold">{{character.fear}}</text></view><view class="setting-line"><text>说话习惯</text><text class="gold">{{character.voice}}</text></view></view><view class="profile-section card"><view class="section-title">参考图</view><view class="reference-row"><view class="reference-art {{character.art}}"><image wx:if="{{character.image}}" src="{{character.image}}" mode="aspectFill"/><text wx:else>暂无参考图</text></view><view><view class="caption">{{character.image ? '已接入作品素材' : '暂无参考图'}}</view><button wx:if="{{!character.image}}" class="secondary-btn" bindtap="generate">生成参考图</button></view></view></view></view></view>
