<view class="page-shell safe-top characters-page"><view class="topbar"><view class="icon-btn" bindtap="back">‹</view><view><view class="top-title">人物图鉴</view><view class="caption">{{workTitle}} · {{characters.length}} 位人物</view></view><view class="icon-btn" bindtap="toast">⌘</view></view><view class="atlas-head"><view class="title-md">故事里的人，<text class="gold">也有自己的秘密。</text></view><view class="body">读者只会看到当前进度允许解锁的信息。作品所有者可查看完整设定。</view><view wx:if="{{canEdit}}" class="mode-switch"><view class="mode {{mode === 'reader' ? 'active' : ''}}" data-mode="reader" bindtap="switchMode">读者视图</view><view class="mode {{mode === 'creator' ? 'active' : ''}}" data-mode="creator" bindtap="switchMode">创作者视图</view></view></view><view wx:if="{{loading}}" class="character-list body">正在整理人物档案…</view><view wx:else class="character-list"><block wx:for="{{characters}}" wx:for-item="character" wx:key="id"><view class="character-card card" data-id="{{character.id}}" bindtap="openDetail"><view class="character-art cover-art {{character.art}}"><image wx:if="{{character.image}}" src="{{character.image}}" mode="aspectFill"/><text wx:else>{{character.name}}</text><view class="character-status {{character.status === '待解锁' ? 'locked' : ''}}">{{character.status}}</view></view><view class="character-copy"><view class="role-line"><view class="character-name">{{character.name}}</view><view class="tag">{{character.role}}</view></view><view class="caption">{{character.relation}}</view><view class="body">{{character.displayIntro}}</view><view class="trait-row"><block wx:for="{{character.displayTraits}}" wx:for-item="trait" wx:key="*this"><text class="trait">{{trait}}</text></block></view></view><view class="character-arrow">›</view></view></block></view><view class="section relationship card" bindtap="toast"><view class="relationship-icon">⌘</view><view><view class="title-md">人物关系图</view><view class="caption">查看人物之间的选择与牵连</view></view><view class="character-arrow">›</view></view></view>
